# ABOUTME: Template for environment variables required by the Gravity Forms MCP server.
# ABOUTME: Copy this file to .env and fill in your values.

# === Required ===
GRAVITY_FORMS_BASE_URL=https://your-wordpress-site.com
GRAVITY_FORMS_CONSUMER_KEY=ck_your_consumer_key_here
GRAVITY_FORMS_CONSUMER_SECRET=cs_your_consumer_secret_here

# Authentication method (currently only 'basic' is supported)
GRAVITY_FORMS_AUTH_METHOD=basic

# === Cache Configuration ===
# Enable/disable form caching (default: true)
GRAVITY_FORMS_CACHE_ENABLED=true

# SQLite database path for cache (default: ./data/forms-cache.db)
GRAVITY_FORMS_CACHE_DB_PATH=./data/forms-cache.db

# Cache entry max age in seconds (default: 3600)
GRAVITY_FORMS_CACHE_MAX_AGE_SECONDS=3600

# Automatic cache synchronization (default: true)
GRAVITY_FORMS_CACHE_AUTO_SYNC=true

# Hours between comprehensive form discovery syncs (default: 24)
GRAVITY_FORMS_FULL_SYNC_INTERVAL_HOURS=24

# Minimum form ID for gap detection (default: lowest existing ID)
# GRAVITY_FORMS_MIN_FORM_ID=1

# === Export Configuration ===
# Where exports are stored (must be absolute; ~ is expanded). Managed files live in <dir>/store/.
# Default: ~/.gravity-forms-mcp/exports
# GRAVITY_FORMS_EXPORT_DIR=/absolute/path/to/exports
# Days to keep exports before they are deleted (1-365, default 7)
# GRAVITY_FORMS_EXPORT_RETENTION_DAYS=7
# Minutes a download link stays valid (1-1440, default 60)
# EXPORT_LINK_TTL_MINUTES=60

# === Search Configuration ===
# SEARCH_CACHE_ENABLED=true
# SEARCH_CACHE_MAX_AGE_MS=900000
# SEARCH_CACHE_MAX_SIZE=100

# === Performance Monitoring ===
# PERFORMANCE_MONITORING_ENABLED=false

# === Transport ===
# Transport: "stdio" (default, local) or "http" (central server)
MCP_TRANSPORT=stdio
# HTTP mode only — port and shared bearer token (required when MCP_TRANSPORT=http)
MCP_HTTP_PORT=9807
MCP_AUTH_TOKEN=
# HTTP mode only — the address your laptop uses to reach this server; download links use it
# MCP_PUBLIC_BASE_URL=http://your-server.local:9807
